{
  "name": "npm-dependencies-ui-geeks",
  "displayName": "UI Geeks: Audit Dependencies",
  "version": "1.0.2",
  "description": "Audit dependencies for vulnerabilities & outdated packages. Generate & download report.",
  "main": "./out/extension.js",
  "publisher": "skumarmca2010",
  "icon": "images/icon.png",
  "categories": [
    "Visualization",
    "Other"
  ],
  "engines": {
    "vscode": "^1.76.0"
  },
  "activationEvents": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skumar-mca/ui-geeks-ext-package-dep.git"
  },
  "author": {
    "name": "Sunil Kumar",
    "email": "skumar.mca2010@gmail.com",
    "url": "https://ui-geeks.in"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/skumar-mca/ui-geeks-ext-package-dep/issues"
  },
  "keywords": [
    "npm",
    "vulnerabilities",
    "outdated packages",
    "package dependencies",
    "dev dependencies",
    "npm modules",
    "report",
    "npm packages",
    "ui-geeks",
    "ui geeks"
  ],
  "homepage": "https://github.com/skumar-mca/ui-geeks-ext-package-dep#readme",
  "contributes": {
    "commands": [
      {
        "command": "ui-geeks-ext-package-dep.runGetDependency",
        "title": "UI Geeks: Audit Dependencies",
        "enablement": "resourceFilename == package-lock.json"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ui-geeks-ext-package-dep.runGetDependency",
          "group": "2_workspace"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm-run-all scss-to-css minify:css package",
    "package": "node esbuild.js --production",
    "scss-to-css": "node-sass src/scss/style.scss out/style.css",
    "minify:css": "cleancss -o out/style.css out/style.css",
    "build:package": "vsce package",
    "pretest": "npm run lint",
    "check-types": "tsc --noEmit",
    "minify:script": "tsc src/scripts/web-script.ts && copyfiles src/scripts/web-script.js out"
  },
  "dependencies": {
    "semver": "7.6.2"
  },
  "devDependencies": {
    "@types/glob": "8.1.0",
    "@types/node": "16.x",
    "@types/semver": "^7.5.8",
    "@types/vscode": "1.76.0",
    "@vscode/vsce": "2.19.0",
    "clean-css-cli": "5.6.3",
    "esbuild": "^0.17.17",
    "glob": "8.1.0",
    "npm-run-all": "4.1.5",
    "node-sass": "9.0.0",
    "typescript": "^5.5.4",
    "vscode": "^1.1.34",
    "terser": "5.32.0",
    "copyfiles": "2.4.1"
  },
  "files": [
    "out/**"
  ]
}
